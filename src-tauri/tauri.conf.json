{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PhoneBridge",
  "version": "0.1.0",
  "identifier": "io.cjscode.phonebridge",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PhoneBridge",
        "width": 1000,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Utility",
    "shortDescription": "Control your Android phone from your Mac",
    "copyright": "© 2026 Caden Moore",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "externalBin": ["binaries/adb", "binaries/scrcpy"],
    "resources": {
      "resources/scrcpy-server": "scrcpy-server",
      "resources/scrcpy-icons/": "scrcpy-icons/",
      "resources/licenses/": "licenses/"
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "dmg": {
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 },
        "windowSize": { "width": 660, "height": 400 }
      }
    }
  }
}
